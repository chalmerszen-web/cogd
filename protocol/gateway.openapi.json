{
  "openapi": "3.1.0",
  "info": {"title": "ESP-Hi Agent mock Gateway", "version": "1.2.0"},
  "servers": [{"url": "https://localhost:8443"}],
  "security": [{"bearerAuth": []}],
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "schemas": {
      "Scope": {"type": "object", "required": ["device_id", "user_id", "session_id"], "properties": {"device_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"}, "user_id": {"type": "string", "minLength": 1, "maxLength": 64}, "session_id": {"type": "string", "minLength": 1, "maxLength": 64}}},
      "Event": {"$ref": "context-event.schema.json"},
      "Batch": {"allOf": [{"$ref": "#/components/schemas/Scope"}, {"type": "object", "required": ["events"], "properties": {"events": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/components/schemas/Event"}}}}]},
      "Ack": {"allOf": [{"$ref": "#/components/schemas/Scope"}, {"type": "object", "required": ["cursor"], "properties": {"cursor": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}}]},
      "Turn": {"allOf": [{"$ref": "#/components/schemas/Scope"}, {"type": "object", "required": ["schema", "turn_id", "round", "stream", "messages", "capabilities"], "properties": {"schema": {"const": "agent.turn/1"}, "turn_id": {"type": "string", "maxLength": 64}, "round": {"type": "integer", "minimum": 0, "maximum": 4}, "stream": {"type": "boolean"}, "messages": {"type": "array", "minItems": 1}, "capabilities": {"type": "array", "maxItems": 32}}}]},
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}}}
    }
  },
  "paths": {
    "/v1/context/events:batch": {"post": {"operationId": "pushBatch", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Batch"}}}}, "responses": {"200": {"description": "Idempotent acceptance", "content": {"application/json": {"schema": {"type": "object", "required": ["accepted", "acked_seq"], "properties": {"accepted": {"type": "integer", "minimum": 0}, "acked_seq": {"type": "integer", "minimum": 1}}}}}}, "400": {"description": "Invalid, cross-scope or conflicting immutable event"}, "401": {"description": "Invalid token"}}}},
    "/v1/context/events": {"get": {"operationId": "pullEvents", "parameters": [{"name": "cursor", "in": "query", "required": true, "schema": {"type": "integer", "minimum": 0}}, {"name": "user_id", "in": "query", "required": true, "schema": {"type": "string"}}, {"name": "session_id", "in": "query", "required": true, "schema": {"type": "string"}}, {"name": "device_id", "in": "query", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Bounded ordered page", "content": {"application/json": {"schema": {"type": "object", "required": ["events", "cursor", "more"], "properties": {"events": {"type": "array", "maxItems": 2, "items": {"$ref": "#/components/schemas/Event"}}, "cursor": {"type": "integer", "minimum": 0}, "more": {"type": "boolean"}}}}}}}}},
    "/v1/context/ack": {"post": {"operationId": "ackCursor", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ack"}}}}, "responses": {"200": {"description": "Monotonic acknowledged cursor", "content": {"application/json": {"schema": {"type": "object", "required": ["ok", "cursor"], "properties": {"ok": {"const": true}, "cursor": {"type": "integer"}}}}}}}}},
    "/v1/agent/turns": {"post": {"operationId": "agentTurn", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Turn"}}}}, "responses": {"200": {"description": "Chat-completion JSON or data-framed SSE, finish_reason then [DONE]. Continuations use the same turn_id and preserve tool_call_id.", "content": {"application/json": {"schema": {"type": "object", "required": ["id", "choices"]}}, "text/event-stream": {"schema": {"type": "string"}}}}, "400": {"description": "Invalid or conflicting turn / missing original tool IDs"}}}}
  }
}
