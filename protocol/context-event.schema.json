{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:esp-hi-agent:context-event:1",
  "title": "agent.context.event/1",
  "type": "object",
  "required": ["schema", "event_id", "device_id", "user_id", "session_id", "device_seq", "lamport", "type", "actor", "content", "policy", "parents"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "agent.context.event/1"},
    "event_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}:[0-9]{20}$"},
    "device_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
    "user_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "device_seq": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "lamport": {"type": "integer", "minimum": 1, "maximum": 9007199254740990},
    "type": {"enum": ["message", "tool_result", "turn", "memory", "tombstone", "summary", "error"]},
    "actor": {"type": "object", "properties": {"type": {"type": "string"}}},
    "content": {"type": "object"},
    "policy": {"type": "object"},
    "parents": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 64}}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "summary"}}}, "then": {"properties": {"content": {"required": ["text", "through_seq"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 1536}, "through_seq": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}, "additionalProperties": false}}}},
    {"if": {"properties": {"type": {"const": "message"}}}, "then": {"properties": {"content": {"required": ["text"], "properties": {"format": {"const": "text/plain"}, "text": {"type": "string"}}}}}},
    {"if": {"properties": {"type": {"const": "tool_result"}}}, "then": {"properties": {"content": {"required": ["tool", "call_id", "turn_id", "result"], "properties": {"tool": {"enum": ["device.status.get", "device.light.get", "device.light.set_rgb", "agent.context.stats", "device.audio.get", "device.audio.play_score", "device.audio.play_song", "device.audio.stop", "device.audio.volume", "device.mic.set", "device.audio.capture", "device.audio.replay", "agent.context.search", "agent.context.summary.get", "agent.context.summary.set", "device.control.capabilities", "device.control.validate", "device.control.run", "device.control.status", "device.control.cancel"]}, "call_id": {"type": "string", "maxLength": 128}, "turn_id": {"type": "string", "maxLength": 64}, "result": {"type": "object"}}}}}},
    {"if": {"properties": {"type": {"const": "turn"}}}, "then": {"properties": {"content": {"required": ["messages"], "properties": {"messages": {"type": "array", "minItems": 2, "maxItems": 22, "items": {"type": "object", "required": ["role"], "properties": {"role": {"enum": ["user", "assistant", "tool"]}, "content": {"type": ["string", "null"]}, "tool_call_id": {"type": "string"}, "tool_calls": {"type": "array", "maxItems": 4}}}}}}}}},
    {"if": {"properties": {"type": {"enum": ["memory", "tombstone"]}}}, "then": {"properties": {"content": {"required": ["key"], "properties": {"key": {"type": "string", "minLength": 1, "maxLength": 64}, "value": {"type": "string", "maxLength": 128}}}}}},
    {"if": {"properties": {"type": {"const": "memory"}}}, "then": {"properties": {"content": {"required": ["value"]}}}},
    {"if": {"properties": {"type": {"const": "error"}}}, "then": {"properties": {"content": {"required": ["turn_id", "error", "partial", "effects"]}}}}
  ],
  "$comment": "String byte budgets are additionally enforced by firmware; JSON Schema lengths count code points. event_id must equal device_id plus zero-padded device_seq. Immutable IDs cannot be reused for different content."
}
