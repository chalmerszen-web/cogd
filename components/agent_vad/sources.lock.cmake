# Hashes of the accepted B speech runtime, after path-only relocation.
function(agent_ten_check relative expected)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ten_root}/${relative}")
  file(SHA256 "${ten_root}/${relative}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Pinned TEN source changed: ${relative}")
  endif()
endfunction()
